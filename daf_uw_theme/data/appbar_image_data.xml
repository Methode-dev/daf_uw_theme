<?xml version="1.0" encoding="utf-8"?>
<!--
    Seeds MuK's sidebar footer image with the DAF Under Writing lockup
    (static/src/img/brand/appbar_logo.png). See res_company.py::
    _m_seed_appbar_image for the "never overwrite a real logo" rule.

    NOT noupdate: the function must run on module updates too, so existing
    databases (which already went through MuK's install hook) are fixed by an
    upgrade. It is idempotent, so re-running it is harmless.

    The lockup is a render of static/src/img/brand/daf_uw_logo.svg (gloss
    included), not drawn by hand.  When it is replaced, add the old file's
    SHA-256 to SUPERSEDED_APPBAR_SHA256 in res_company.py.
-->
<odoo>
    <function model="res.company" name="_m_seed_appbar_image"/>
</odoo>
