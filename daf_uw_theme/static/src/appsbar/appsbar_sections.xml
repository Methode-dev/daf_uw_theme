<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

  <t t-name="daf_uw_theme.AppsBar" t-inherit="muk_web_appsbar.AppsBar" t-inherit-mode="extension">
    <xpath expr="//a[@role='menuitem']" position="after">
      <ul
        t-if="app.id === this.appMenuService.getCurrentApp()?.id"
        class="m-app-sections list-unstyled"
      >
        <t t-foreach="appSections(app)" t-as="section" t-key="section.id">
          <li t-if="section.childrenTree.length" class="m-app-section m-app-section--primary">
            <div class="m-app-section-title" t-out="section.name"/>
            <ul class="list-unstyled">
              <t t-foreach="section.childrenTree" t-as="item" t-key="item.id">
                <t t-call="daf_uw_theme.AppsBar.Section">
                  <t t-set="entry" t-value="item"/>
                </t>
              </t>
            </ul>
          </li>
          <t t-else="">
            <t t-call="daf_uw_theme.AppsBar.Section">
              <t t-set="entry" t-value="section"/>
            </t>
          </t>
        </t>
      </ul>
    </xpath>
  </t>

  <!-- One clickable entry; a deeper level is flattened under it, indented. -->
  <t t-name="daf_uw_theme.AppsBar.Section">
    <li class="m-app-section">
      <a
        href="#"
        class="m-app-section-link"
        t-att-data-menu-xmlid="entry.xmlid"
        t-on-click.prevent="() => this.onSectionClick(entry)"
        t-out="entry.name"
      />
    </li>
    <t t-foreach="entry.childrenTree" t-as="child" t-key="child.id">
      <t t-call="daf_uw_theme.AppsBar.Section">
        <t t-set="entry" t-value="child"/>
      </t>
    </t>
  </t>

</templates>
